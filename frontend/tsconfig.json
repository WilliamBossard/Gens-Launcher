{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "renderer.js",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/gens-core/components/skinview3d.bundle.min.js",
    "src/types/main.ts"
  ]
}
