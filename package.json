{
  "name": "gens-launcher",
  "version": "1.8.9",
  "description": "Lanceur Minecraft moderne et rapide.",
  "main": "main.js",
  "author": "William Bossard <wbossard@free.fr>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --linux",
    "test": "node --test tests/crypto-utils.test.js tests/utils.test.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0",
    "yauzl-promise": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gens.launcher",
    "productName": "Gens Launcher",
    "electronVersion": "44.2.0",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WilliamBossard",
        "repo": "Gens-Launcher"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "Désinstaller Gens Launcher"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "assets/icon-512.png",
      "artifactName": "GensLauncher-${version}-${arch}.${ext}",
      "executableArgs": [
        "--no-sandbox",
        "--disable-setuid-sandbox"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon-512.png",
      "category": "public.app-category.games"
    },
    "deb": {
      "priority": "optional",
      "maintainer": "William Bossard <wbossard@free.fr>"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}